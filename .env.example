# =============================================================================
# Store Intelligence — Environment Configuration
# Copy this file to .env and adjust values for your local environment.
# =============================================================================

# --- Database (SQLite only) ---
# Local development (relative path under ./data/)
DATABASE_URL=sqlite:///./data/store_intelligence.db
# Docker container (absolute path — 4 slashes after sqlite:)
# DATABASE_URL=sqlite:////app/data/store_intelligence.db

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_WORKERS=1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log

# --- Event Ingestion ---
EVENT_BATCH_SIZE=500
EVENT_BATCH_MAX_BYTES=10485760

# --- Pipeline ---
PIPELINE_FPS=15
PIPELINE_CONFIDENCE_THRESHOLD=0.25
PIPELINE_DWELL_INTERVAL_SEC=30
PIPELINE_REENTRY_WINDOW_SEC=300
YOLO_MODEL=yolov8n.pt
PIPELINE_DEVICE=cpu
# PIPELINE_DEVICE=cuda:0

# --- Data Paths ---
DATA_DIR=./data
CLIPS_DIR=./data/clips
STORE_LAYOUT_PATH=./data/store_layout.json
POS_TRANSACTIONS_PATH=./data/pos_transactions.csv
SAMPLE_EVENTS_PATH=./data/sample_events.jsonl
EVENTS_OUTPUT_DIR=./data/events

# --- API Client (pipeline → API) ---
API_BASE_URL=http://localhost:8000
API_INGEST_ENDPOINT=/events/ingest

# --- POS Correlation ---
POS_CONVERSION_WINDOW_MINUTES=5

# --- Anomaly Detection ---
ANOMALY_QUEUE_SPIKE_MULTIPLIER=2.0
ANOMALY_CONVERSION_LOOKBACK_DAYS=7
ANOMALY_DEAD_ZONE_MINUTES=30
STALE_FEED_THRESHOLD_MINUTES=10

# --- Health Check ---
HEALTH_CHECK_INTERVAL_SEC=30

# --- Dashboard (Streamlit) ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
DASHBOARD_REFRESH_SEC=5
DASHBOARD_DEFAULT_STORE_ID=STORE_BLR_002

# --- Docker / Compose ---
COMPOSE_PROJECT_NAME=store-intelligence

# --- Testing ---
TEST_DATABASE_URL=sqlite:///./data/test_store_intelligence.db
